{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=tcp:<YOUR_AZURE_SERVER>.database.windows.net,1433;Initial Catalog=<YOUR_DATABASE>;Persist Security Info=False;User ID=<YOUR_USER_ID>;Password=<YOUR_PASSWORD>;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=60;"
  },
  "EmailSettings": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "Email": "your-email@gmail.com",
    "Password": "<YOUR_GMAIL_APP_PASSWORD>"
  },
  "JwtSettings": {
    "Key": "<YOUR_JWT_SECRET_KEY_MIN_32_CHARS>",
    "Issuer": "BeautyParlourAPI",
    "Audience": "BeautyParlourAdmin",
    "DurationInMinutes": 120
  },
  "Twilio": {
    "AccountSid": "<YOUR_TWILIO_ACCOUNT_SID>",
    "AuthToken": "<YOUR_TWILIO_AUTH_TOKEN>",
    "PhoneNumber": "<YOUR_TWILIO_PHONE_NUMBER>"
  },
  "Otp": {
    "ExpiryMinutes": 5,
    "ResendCooldownSeconds": 60,
    "MaxAttempts": 5,
    "HashKey": "<YOUR_OTP_HASH_KEY>"
  }
}
